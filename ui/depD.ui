  <property name="styleSheet">
   <string notr="true">
    QMainWindow {
        background-color: #0b0f19;
    }
    QWidget {
        color: #ffffff;
        font-family: 'Segoe UI', sans-serif;
    }
    /* Main Card / Container */
    #centralWidget {
        background-color: #121824;
        border: 1px solid #1e293b;
        border-radius: 8px;
    }
    /* Item Cards */
    QFrame.itemCard {
        background-color: #171f30;
        border: 1px solid #222e45;
        border-radius: 8px;
    }
    /* Labels */
    QLabel {
        color: #f8fafc;
        background: transparent;
    }
    .titleLabel {
        font-size: 16px;
        font-weight: bold;
    }
    .statusLabel {
        font-size: 13px;
        color: #94a3b8;
    }
    /* Default Buttons */
    QPushButton {
        background-color: #1e293b;
        border: 1px solid #334155;
        border-radius: 6px;
        padding: 6px 12px;
        color: #ffffff;
        font-weight: 500;
    }
    QPushButton:hover {
        background-color: #273548;
    }
    /* Primary / Download Buttons */
    QPushButton#btnFfmpegDownload, QPushButton#btnDenoDownload, QPushButton#btnYtDlpDownload, QPushButton#downloadAllButton {
        background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1d4ed8, stop:1 #1e40af);
        border: 1px solid #3b82f6;
        border-radius: 6px;
        font-weight: bold;
    }
    QPushButton#btnFfmpegDownload:hover, QPushButton#btnDenoDownload:hover, QPushButton#btnYtDlpDownload:hover, QPushButton#downloadAllButton:hover {
        background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2563eb, stop:1 #1d4ed8);
    }
    /* Pause နှင့် Cancel ခလုတ်များ */
    QPushButton[objectName*=&quot;Pause&quot;], QPushButton[objectName*=&quot;Cancel&quot;] {
        background-color: #1e293b;
        border: 1px solid #334155;
        border-radius: 6px;
        padding: 6px 12px;
        color: #f8fafc;
        font-weight: 500;
        min-height: 24px;
    }
    QPushButton[objectName*=&quot;Pause&quot;]:hover, QPushButton[objectName*=&quot;Cancel&quot;]:hover {
        background-color: #334155;
        border-color: #475569;
    }
    /* Progress Bar */
    QProgressBar {
        background-color: #0f172a;
        border: none;
        border-radius: 4px;
        height: 6px;
        text-align: center;
    }
    QProgressBar::chunk {
        background-color: #3b82f6;
        border-radius: 4px;
    }
   </string>
  </property>
