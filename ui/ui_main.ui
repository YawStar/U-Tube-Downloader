  <property name="styleSheet">
   <string notr="true">QMainWindow { background-color: #161616; }
QWidget { color: #ffffff; font-family: &quot;Pyidaungsu&quot;; font-size: 11pt; }
QLineEdit, QTextEdit { background-color: #111111; border: 1px solid #444444; border-radius: 2px; padding: 6px; color: #ffffff; }
QLineEdit:focus, QTextEdit:focus { border: 1px solid #ffffff; }
QPushButton { background-color: #ffffff; color: #161616; border: 1px solid #ffffff; border-radius: 4px; padding: 8px 16px; font-weight: bold; }
QPushButton:hover { background-color: #00A2FF; }
QPushButton:pressed { background-color: #cccccc; }
QPushButton:disabled { background-color: #555555; color: #888888; border: 1px solid #555555;}
QPushButton[selected=&quot;true&quot;] { background-color: #27AE60; }
QPushButton[selected=&quot;true&quot;]:hover { background-color: #1AD76A; }
QPushButton[selected=&quot;true&quot;]:pressed { background-color: #229954; }
QPushButton[selected=&quot;true&quot;]:disabled { background-color: #555555; color: #888888; border: 1px solid #555555; }
QPushButton[working=&quot;true&quot;] { background-color: #FF3E00; color: #FFFFFF }
QPushButton[working=&quot;true&quot;]:hover { background-color: #FF4E00; color: #FFFFFF }
QPushButton[working=&quot;true&quot;]:pressed { background-color: #229954; color: #FFFFFF }
QProgressBar { border: 1px solid #444444; border-radius: 2px; text-align: center; background-color: #111111; color: #ffffff; font-weight: bold; }
QProgressBar::chunk { background-color: #00A2FF; }</string>
  </property>
